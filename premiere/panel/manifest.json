{
  "manifestVersion": 5,
  "id": "com.qcpie.linefinder",
  "name": "LineFinder",
  "version": "0.0.3",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "linefinder",
      "label": {
        "default": "LineFinder"
      },
      "minimumSize": {
        "width": 240,
        "height": 260
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 480
      }
    }
  ]
}
