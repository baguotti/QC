{
  "manifestVersion": 5,
  "id": "com.qcpie.linefinder",
  "name": "LineFinder",
  "version": "0.0.7",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "https://api.github.com",
        "https://github.com",
        "https://release-assets.githubusercontent.com",
        "https://objects.githubusercontent.com"
      ]
    },
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": [
        ".pkg",
        ".ccx"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "linefinder",
      "label": {
        "default": "LineFinder"
      },
      "minimumSize": {
        "width": 240,
        "height": 260
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 480
      }
    }
  ]
}
